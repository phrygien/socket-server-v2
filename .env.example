# ==============================================================================
# AUCTAV REALTIME SOCKET.IO SERVER - CONFIGURATION
# ==============================================================================

# Port d'écoute du serveur HTTP / Socket.IO
PORT=3000

# Clé secrète requise pour authentifier l'administrateur régie / commissaire-priseur.
# OBLIGATOIRE : à changer impérativement en production avec une chaîne aléatoire forte.
ADMIN_KEY="auctav_live_secret_key_prod_2026_xyz"

# Origines CORS autorisées (séparées par une virgule).
# ATTENTION : Ne jamais utiliser '*' car 'credentials: true' est activé pour les sessions PHP/cookies.
ALLOWED_ORIGINS="https://www.auctav.com,https://auctav.com,https://socket-auctav.astucom.com"

# URL de connexion Redis pour le clustering multi-instances et la persistance de l'AdminStore (OPTIONNEL).
# Si vide ou non renseigné, le serveur utilise le stockage mémoire interne (Map).
# Format : redis://[:password@]host[:port][/db-number]
# REDIS_URL="redis://127.0.0.1:6379"

# Niveau de journalisation structurée (Pino) : 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL="info"

# Compatibilité temporaire pour l'ancienne page régie 'update.php'.
# - false (RECOMMANDÉ) : update.php DOIT émettre l'événement 'admin' avec ADMIN_KEY avant d'émettre updateLot.
# - true (RISQUE SÉCURITÉ) : Autorise l'émission non authentifiée du message 'updateLot' via getMsgRoom.
ALLOW_UNAUTH_UPDATELOT=false
